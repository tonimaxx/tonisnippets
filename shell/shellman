#!/usr/bin/env zsh
# shellman — manage custom zsh functions in ~/.zsh_functions
# Usage: shellman <command> [args]

FUNCTIONS_FILE="$HOME/.zsh_functions"
GITHUB_REPO="tonimaxx/tonisnippets"
GITHUB_PATH="shell/dev-process-manager.zsh"

_sm_help() {
  echo "shellman — zsh function manager"
  echo ""
  echo "Commands:"
  echo "  list              Show all functions with descriptions"
  echo "  show <name>       Print source of a function"
  echo "  new <name>        Add a new function (interactive)"
  echo "  edit <name>       Open function in \$EDITOR"
  echo "  delete <name>     Remove a function"
  echo "  reload            Reload ~/.zshrc in current session hint"
  echo "  sync              Push ~/.zsh_functions to GitHub"
  echo "  help              Show this message"
}

_sm_list() {
  awk '
    /^# description:/ {
      sub(/^# description: */, ""); desc = $0; next
    }
    /^[a-z_][a-z0-9_]*\(\) \{/ {
      name = $0; sub(/\(\).*/, "", name)
      if (desc == "") desc = "(no description)"
      printf "  %-16s %s\n", name, desc
      count++
      desc = ""
      next
    }
    { desc = "" }
    END { printf "\n  %d function(s) in %s\n", count, file }
  ' file="$FUNCTIONS_FILE" "$FUNCTIONS_FILE"
}

_sm_show() {
  local name="$1"
  if [[ -z "$name" ]]; then echo "Usage: shellman show <name>"; return 1; fi

  if ! grep -q "^${name}() {" "$FUNCTIONS_FILE"; then
    echo "Function '$name' not found in $FUNCTIONS_FILE"
    return 1
  fi

  awk -v name="$name" '
    /^# description:/ { desc = $0; next }
    $0 == name "() {" {
      if (desc != "") print desc
      print $0
      depth = 1
      in_func = 1
      desc = ""
      next
    }
    in_func {
      print $0
      for (i=1; i<=length($0); i++) {
        c = substr($0, i, 1)
        if (c == "{") depth++
        if (c == "}") depth--
      }
      if (depth <= 0) exit
      next
    }
    { desc = "" }
  ' "$FUNCTIONS_FILE"
}

_sm_new() {
  local name="$1"
  if [[ -z "$name" ]]; then echo "Usage: shellman new <name>"; return 1; fi

  if grep -q "^${name}() {" "$FUNCTIONS_FILE"; then
    echo "Error: function '$name' already exists. Use: shellman edit $name"
    return 1
  fi

  echo -n "Description (one line): "
  read desc
  echo -n "Body (leave blank to open in \$EDITOR): "
  read body

  local scaffold
  if [[ -z "$body" ]]; then
    local tmpfile=$(mktemp /tmp/shellman_XXXX.zsh)
    cat > "$tmpfile" <<EOF

# description: $desc
${name}() {
  # TODO: implement
}
EOF
    ${EDITOR:-nano} "$tmpfile"
    scaffold=$(cat "$tmpfile")
    rm "$tmpfile"
  else
    scaffold="\n# description: $desc\n${name}() {\n  $body\n}"
  fi

  echo "$scaffold" >> "$FUNCTIONS_FILE"
  echo "Added '$name' to $FUNCTIONS_FILE"
  echo "Run: source ~/.zshrc"
}

_sm_edit() {
  local name="$1"
  if [[ -z "$name" ]]; then echo "Usage: shellman edit <name>"; return 1; fi

  if ! grep -q "^${name}() {" "$FUNCTIONS_FILE"; then
    echo "Function '$name' not found."
    return 1
  fi

  ${EDITOR:-nano} "$FUNCTIONS_FILE"
  echo "Done. Run: source ~/.zshrc"
}

_sm_delete() {
  local name="$1"
  if [[ -z "$name" ]]; then echo "Usage: shellman delete <name>"; return 1; fi

  if ! grep -q "^${name}() {" "$FUNCTIONS_FILE"; then
    echo "Function '$name' not found."
    return 1
  fi

  echo "--- Source ---"
  _sm_show "$name"
  echo "-------------"
  echo -n "Delete '$name'? [y/N] "
  read confirm
  [[ "$confirm" != "y" && "$confirm" != "Y" ]] && echo "Cancelled." && return 0

  # Remove description comment + function block
  local tmpfile=$(mktemp)
  local skip=0
  local brace_depth=0

  while IFS= read -r line; do
    if [[ "$line" =~ ^#\ description: ]] && grep -q "^${name}() {" "$FUNCTIONS_FILE"; then
      # peek at next non-blank line — handled by flag approach below
      skip=2
    fi

    if [[ $skip -eq 2 ]]; then
      skip=1
      continue
    elif [[ $skip -eq 1 ]]; then
      if [[ "$line" =~ ^${name}\(\)\ \{ ]]; then
        brace_depth=1
        skip=0
        continue
      else
        # description wasn't for this function — write it back
        skip=0
      fi
    fi

    if [[ $brace_depth -gt 0 ]]; then
      [[ "$line" == *"{"* ]] && (( brace_depth += $(echo "$line" | tr -cd '{' | wc -c) ))
      [[ "$line" == *"}"* ]] && (( brace_depth -= $(echo "$line" | tr -cd '}' | wc -c) ))
      [[ $brace_depth -le 0 ]] && brace_depth=0
      continue
    fi

    echo "$line" >> "$tmpfile"
  done < "$FUNCTIONS_FILE"

  mv "$tmpfile" "$FUNCTIONS_FILE"
  echo "Deleted '$name'. Run: source ~/.zshrc"
}

_sm_reload() {
  echo "Run this in your terminal:"
  echo ""
  echo "  source ~/.zshrc"
  echo ""
  echo "Note: shellman cannot reload your live shell — you must run it yourself."
}

_sm_sync() {
  echo "Syncing $FUNCTIONS_FILE → github.com/$GITHUB_REPO/$GITHUB_PATH ..."

  local content
  content=$(base64 < "$FUNCTIONS_FILE")

  local sha
  sha=$(gh api "repos/$GITHUB_REPO/contents/$GITHUB_PATH" --jq '.sha' 2>/dev/null)

  if [[ -n "$sha" ]]; then
    gh api "repos/$GITHUB_REPO/contents/$GITHUB_PATH" \
      --method PUT \
      --field message="Update shell functions via shellman" \
      --field content="$content" \
      --field sha="$sha" \
      --jq '.content.html_url' && echo "Synced."
  else
    gh api "repos/$GITHUB_REPO/contents/$GITHUB_PATH" \
      --method PUT \
      --field message="Add shell functions via shellman" \
      --field content="$content" \
      --jq '.content.html_url' && echo "Synced."
  fi
}

# --- Router ---
case "$1" in
  list)    _sm_list ;;
  show)    _sm_show "$2" ;;
  new)     _sm_new "$2" ;;
  edit)    _sm_edit "$2" ;;
  delete)  _sm_delete "$2" ;;
  reload)  _sm_reload ;;
  sync)    _sm_sync ;;
  help|"") _sm_help ;;
  *)       echo "Unknown command: $1"; _sm_help; exit 1 ;;
esac
